---
interface Props {
    question: string,
    response: string
}

const { question, response } = Astro.props
---

<div class="border-2 rounded-md w-full h-screen max-h-[25vh] lg:max-w-[75vh] border-[#7F00FF] text-white p-3">
    <h1 class="lg:text-2xl text-[18px] font-semibold text-center mb-3 underline">{question}</h1>
    <p class="text-sm">{response}</p>
</div>