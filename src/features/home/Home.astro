---
import Hero from "./components/Hero.astro";
import AboutTheBot from "./components/AboutTheBot.astro";
import './styles/home.css'
---

<div class="flex h-full w-full flex-col gap-y-20 overflow-x-hidden">

    { /* background desktop */ }
    <img src="elementos.png" alt="elementos" 
    class="absolute inset-0 z-0 contrast-90 brightness-35 hidden lg:block"/>

    { /* background celular */ }
    <img src="medoMobile.jpg" alt="medo" 
    class="absolute inset-0 z-0 top-[-6rem] contrast-90 brightness-35 block w-full lg:hidden"/>

    <Hero />
    <AboutTheBot />
</div>