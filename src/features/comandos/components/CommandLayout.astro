---
interface Props {
    title:string
    description:string
}

const { description, title } = Astro.props
---

<div class="bg-[#111C3A] p-4 rounded-md border-l-4 border-[#7F00FF] shadow-md">
    <strong class="text-[#61dafbaa] text-2xl">{title}</strong>
    <p class="text-white">{description}</p>
</div>