---
import CommandLayout from "./CommandLayout.astro";
---
<div id="ordoRealitasCommands" class="p-2 flex flex-col gap-y-2">
    <CommandLayout title="/ficha" description="Permite criar uma ficha para jogar o RPG do Ordo Realitas. Caso já tenha uma ficha criada, você verá toda a sua ficha de personagem."/>
    <CommandLayout title="/combate" description="Entre em combate com monstros de baixo NEX."/>
    <CommandLayout title="/duelo" description="Desafie outro jogador para um duelo."/>
    <CommandLayout title="/dungeon" description="Desafie dungeons de diferentes níveis e monstros e ganhe itens poderosos."/>
    <CommandLayout title="/eitem" description="Equipe um item desejado."/>
    <CommandLayout title="/eritual" description="Equipe um ritual desejado."/>
    <CommandLayout title="/loja" description="Compre ou venda itens. A loja muda de itens diariamente."/>
    <CommandLayout title="/missoes" description="Veja suas missões diárias. Ganhe dinheiro e recompensas aleatórias."/>
    <CommandLayout title="/vote" description="Vote no Ordo Realitas e ganhe recompensas!"/>
    <CommandLayout title="/info" description="Veja as informações do Ordo Realitas."/>
</div>